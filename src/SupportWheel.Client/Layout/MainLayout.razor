@inherits LayoutComponentBase
@using System.Globalization
@using SupportWheel.Client.Resources
@using SupportWheel.Client.Services
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="container py-5 page-enter" style="max-width: 720px;">
    <header class="text-center mb-5 header-grid">
        <div></div>
        <h1 style="font-size: 2.5rem; font-weight: 700;
                   background: linear-gradient(135deg, #a78bfa, #7c5cfc, #60a5fa);
                   -webkit-background-clip: text; -webkit-text-fill-color: transparent;
                   background-clip: text; filter: drop-shadow(0 0 24px rgba(124,92,252,0.3));
                   margin: 0;">
            @Translation.AppTitle
        </h1>
        <button @onclick="ToggleLanguageAsync"
                class="btn btn-link"
                style="justify-self: end; cursor: pointer;
                       font-size: 0.85rem; color: #a78bfa;
                       text-decoration: none; opacity: 0.8; padding: 0;
                       white-space: nowrap;"
                title="@LanguageToggleText">
            🌐 @LanguageToggleText
        </button>
    </header>

    <main>
        @Body
    </main>

    <footer class="text-center mt-4" style="font-size: 0.7rem; color: var(--text-secondary); opacity: 0.5;">
        v@(AppInfo.Version) · @(AppInfo.DotNetVersion) · @FormatBuildDate()
        · <a href="/api-docs" style="color: var(--accent-light); text-decoration: none; opacity: 0.8;">@Translation.ApiDocsLink</a>
    </footer>
</div>

<style>
    .header-grid {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
    }

    @@media (max-width: 500px) {
        .header-grid {
            grid-template-columns: 1fr;
            justify-items: center;
            gap: 0.5rem;
        }

        .header-grid > div:first-child {
            display: none;
        }
    }
</style>

@code {
    private string LanguageToggleText =>
        CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en"
            ? Translation.SwitchToSwedish
            : Translation.SwitchToEnglish;

    private async Task ToggleLanguageAsync()
    {
        var newLang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "sv" ? "en" : "sv";
        await JS.InvokeVoidAsync("localStorage.setItem", "supportwheel-lang", newLang);
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private static string FormatBuildDate()
    {
        if (DateTimeOffset.TryParse(AppInfo.BuildDate, out var date))
            return date.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
        return AppInfo.BuildDate;
    }
}
