@page "/"
@implements IDisposable
@inject NavigationManager Navigation
@inject CultureState CultureState
@inject SavedWheelService SavedWheelService

<PageTitle>@Translation.PageTitleHome</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">

        <div class="glass-card p-4 p-md-5">
            <h2 style="font-weight: 600; margin-bottom: 1.5rem; font-size: 1.4rem;">@Translation.AddYourItems</h2>

            <div class="mb-4">
                <label for="itemsInput" class="form-label">
                    @Translation.EnterOnePerLine
                </label>
                <textarea @bind="itemsText"
                          @bind:event="oninput"
                          id="itemsInput"
                          class="form-control"
                          rows="8"
                          placeholder="@Translation.PlaceholderItems"></textarea>

                @if (Duplicates.Count > 0)
                {
                    <div class="alert alert-warning mt-2 mb-0" role="alert">
                        @string.Format(Translation.DuplicateWarning, string.Join(", ", Duplicates))
                    </div>
                }

                <div class="mt-2 text-end" style="color: var(--text-secondary); font-size: 0.85rem;">
                    @string.Format(Translation.ItemsEntered, ParsedItems.Length)
                </div>
            </div>

            <div class="mb-4">
                <label for="countInput" class="form-label">
                    @Translation.HowManyToPick
                </label>
                <input type="number"
                       @bind="count"
                       id="countInput"
                       class="form-control"
                       min="1"
                       max="@MaxCount"
                       style="max-width: 120px;" />
            </div>

            @if (count > 1)
            {
                <div class="mb-4">
                    <div class="form-check" style="display: inline-flex; align-items: center; gap: 0.5rem;">
                        <input type="checkbox" @bind="oneAtATime" id="oneAtATimeCheck"
                               class="form-check-input" style="width: 1.2em; height: 1.2em;" />
                        <label for="oneAtATimeCheck" class="form-check-label" style="color: var(--text-secondary); font-weight: 500;">
                            @Translation.OneAtATime
                        </label>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    @errorMessage
                </div>
            }

            <button @onclick="DoSpin"
                    class="btn-glow w-100"
                    disabled="@(!CanSpin)">
                @Translation.SpinButton
            </button>

            @if (CanSpin && !showSaveInput)
            {
                <button @onclick="BeginSave" class="btn-ghost w-100 mt-2">
                    @Translation.SaveWheel
                </button>
            }

            @if (showSaveInput)
            {
                <div class="d-flex gap-2 mt-2 align-items-center">
                    <input @bind="saveWheelName" @bind:event="oninput"
                           class="form-control" style="max-width: 250px;"
                           placeholder="@Translation.SaveWheelPrompt"
                           @onkeydown="HandleSaveKeyDown" />
                    <button class="btn-ghost btn-sm" @onclick="ConfirmSaveWheel"
                            disabled="@(string.IsNullOrWhiteSpace(saveWheelName))">
                        ✓
                    </button>
                    <button class="btn-ghost btn-sm" @onclick="CancelSave">
                        ✕
                    </button>
                </div>
            }

            @if (wheelSaved)
            {
                <div class="toast-copied mt-2 text-center"><small>@Translation.WheelSaved</small></div>
            }
        </div>

        @if (savedWheels.Count > 0)
        {
            <div class="glass-card p-4 mt-4">
                <h2 style="font-weight: 600; font-size: 1.2rem; margin-bottom: 1rem;">@Translation.MyWheels</h2>
                @foreach (var wheel in savedWheels)
                {
                    <div class="saved-wheel-item">
                        <div>
                            <strong>@wheel.Name</strong>
                            <small>@string.Format(Translation.ItemCount, wheel.Items.Length)</small>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn-ghost btn-sm" @onclick="() => LoadWheel(wheel)">@Translation.LoadWheel</button>
                            <button class="btn-ghost btn-sm" style="color: var(--danger);" @onclick="() => DeleteWheel(wheel.Id)">@Translation.DeleteWheel</button>
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</div>

@code {
    private string itemsText = "";
    private int count = 1;
    private bool oneAtATime;
    private string? errorMessage;
    private List<SavedWheel> savedWheels = [];
    private bool wheelSaved;
    private bool showSaveInput;
    private string saveWheelName = "";
    private System.Threading.Timer? toastTimer;

    protected override void OnInitialized()
    {
        CultureState.OnCultureChanged += OnCultureChanged;

        var uri = Navigation.Uri;
        var queryIndex = uri.IndexOf('?');
        if (queryIndex < 0) return;

        var queryString = uri[(queryIndex + 1)..];
        var pairs = queryString.Split('&', StringSplitOptions.RemoveEmptyEntries);

        foreach (var pair in pairs)
        {
            var parts = pair.Split('=', 2);
            if (parts.Length != 2) continue;

            var key = Uri.UnescapeDataString(parts[0]);
            var value = Uri.UnescapeDataString(parts[1]);

            if (key == "items") itemsText = value;
            else if (key == "count" && int.TryParse(value, out var c)) count = c;
            else if (key == "seq" && value == "true") oneAtATime = true;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        savedWheels = await SavedWheelService.GetAllAsync();
    }

    private void OnCultureChanged() => InvokeAsync(StateHasChanged);

    private string[] ParsedItems => itemsText
        .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Where(s => !string.IsNullOrWhiteSpace(s))
        .ToArray();

    private IReadOnlyList<string> Duplicates => ParsedItems
        .GroupBy(s => s, StringComparer.OrdinalIgnoreCase)
        .Where(g => g.Count() > 1)
        .Select(g => g.Key)
        .ToList();

    private int MaxCount => Math.Max(1, ParsedItems.Length);

    private bool CanSpin => ParsedItems.Length >= 2
                            && count >= 1
                            && count <= ParsedItems.Length
                            && Duplicates.Count == 0;

    private void DoSpin()
    {
        errorMessage = null;
        var items = ParsedItems;

        if (items.Length < 2)
        {
            errorMessage = Translation.ErrorMinItems;
            return;
        }

        if (count < 1 || count > items.Length)
        {
            errorMessage = string.Format(Translation.ErrorPickCount, items.Length);
            return;
        }

        var duplicates = Duplicates;
        if (duplicates.Count > 0)
        {
            errorMessage = string.Format(Translation.ErrorDuplicates, string.Join(", ", duplicates));
            return;
        }

        var result = WheelSpinner.Spin(items, count);
        var encoded = SpinEncoder.Encode(result);
        var url = oneAtATime ? $"/spin/{encoded}?seq=true" : $"/spin/{encoded}";
        Navigation.NavigateTo(url);
    }

    private void BeginSave()
    {
        showSaveInput = true;
        saveWheelName = "";
    }

    private void CancelSave()
    {
        showSaveInput = false;
        saveWheelName = "";
    }

    private async Task HandleSaveKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await ConfirmSaveWheel();
        else if (e.Key == "Escape")
            CancelSave();
    }

    private async Task ConfirmSaveWheel()
    {
        if (string.IsNullOrWhiteSpace(saveWheelName)) return;

        var wheel = new SavedWheel
        {
            Name = saveWheelName.Trim(),
            Items = ParsedItems,
            PickCount = count
        };

        await SavedWheelService.SaveAsync(wheel);
        savedWheels = await SavedWheelService.GetAllAsync();

        showSaveInput = false;
        saveWheelName = "";
        wheelSaved = true;
        StateHasChanged();

        toastTimer?.Dispose();
        toastTimer = new System.Threading.Timer(_ =>
        {
            wheelSaved = false;
            InvokeAsync(StateHasChanged);
        }, null, 2000, Timeout.Infinite);
    }

    private void LoadWheel(SavedWheel wheel)
    {
        itemsText = string.Join("\n", wheel.Items);
        count = wheel.PickCount;
    }

    private async Task DeleteWheel(string id)
    {
        await SavedWheelService.DeleteAsync(id);
        savedWheels = await SavedWheelService.GetAllAsync();
    }

    public void Dispose()
    {
        CultureState.OnCultureChanged -= OnCultureChanged;
        toastTimer?.Dispose();
    }
}
