@page "/"
@implements IDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject CultureState CultureState
@inject SavedWheelService SavedWheelService
@inject PartyModeState PartyState

<PageTitle>@Translation.PageTitleHome</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">

        <div class="glass-card p-4 p-md-5">
            <h2 style="font-weight: 600; margin-bottom: 1.5rem; font-size: 1.4rem;">@Translation.AddYourItems</h2>

            <div class="mb-4">
                <label for="itemsInput" class="form-label">
                    @Translation.EnterOnePerLine
                </label>
                <div class="textarea-with-gutter">
                    <div class="color-gutter" id="colorGutter">
                        @{
                            var allLines = itemsText.Split('\n');
                            var gutterColors = ColorGenerator.GenerateColors(ParsedItems.Length);
                            int colorIdx = 0;
                        }
                        @for (int i = 0; i < allLines.Length; i++)
                        {
                            var line = allLines[i].Trim();
                            if (!string.IsNullOrWhiteSpace(line) && colorIdx < gutterColors.Length)
                            {
                                <div class="gutter-line">
                                    <span class="color-dot" style="background: @gutterColors[colorIdx];"></span>
                                </div>
                                colorIdx++;
                            }
                            else
                            {
                                <div class="gutter-line"></div>
                            }
                        }
                    </div>
                    <textarea @bind="itemsText"
                              @bind:event="oninput"
                              @bind:after="OnItemsChanged"
                              id="itemsInput"
                              class="form-control"
                              rows="8"
                              placeholder="@Translation.PlaceholderItems"
                              onscroll="document.getElementById('colorGutter').scrollTop=this.scrollTop"></textarea>
                </div>

                @if (Duplicates.Count > 0)
                {
                    <div class="alert alert-warning mt-2 mb-0" role="alert">
                        @string.Format(Translation.DuplicateWarning, string.Join(", ", Duplicates))
                    </div>
                    <div class="form-check mt-1" style="display: inline-flex; align-items: center; gap: 0.5rem;">
                        <input type="checkbox" @bind="allowDuplicates" id="allowDuplicatesCheck"
                               class="form-check-input" style="width: 1.2em; height: 1.2em;" />
                        <label for="allowDuplicatesCheck" class="form-check-label" style="color: var(--text-secondary); font-weight: 500;">
                            @Translation.AllowDuplicates
                        </label>
                    </div>
                }

                <div class="mt-2 text-end" style="color: var(--text-secondary); font-size: 0.85rem;">
                    @string.Format(Translation.ItemsEntered, ParsedItems.Length)
                </div>


            </div>

            @if (ParsedItems.Length >= 2)
            {
                <div class="mb-4">
                    <div class="party-picker">
                        <div class="party-header">
                            <button type="button"
                                    class="party-toggle @(PartyState.Enabled ? "on" : "")"
                                    @onclick="ToggleParty">
                                🎉 @Translation.PartyMode
                            </button>
                            @if (PartyState.Enabled)
                            {
                                <button type="button"
                                        class="party-mute @(PartyState.Muted ? "muted" : "")"
                                        @onclick="ToggleMute"
                                        title="@(PartyState.Muted ? "Unmute" : "Mute")">
                                    @(PartyState.Muted ? "🔇" : "🔊")
                                </button>
                            }
                        </div>
                        @if (PartyState.Enabled)
                        {
                            <div class="party-levels">
                                <button type="button"
                                        class="party-pick @(PartyState.Intensity == 1 ? "selected" : "")"
                                        @onclick="() => SetPartyLevel(1)">
                                    🎈 Lugnt
                                </button>
                                <button type="button"
                                        class="party-pick @(PartyState.Intensity == 2 ? "selected" : "")"
                                        @onclick="() => SetPartyLevel(2)">
                                    🎉 Kul
                                </button>
                                <button type="button"
                                        class="party-pick @(PartyState.Intensity == 3 ? "selected" : "")"
                                        @onclick="() => SetPartyLevel(3)">
                                    🤯 KAOS
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="mb-4">
                <label for="countInput" class="form-label">
                    @Translation.HowManyToPick
                </label>
                <div class="count-picker">
                    <button type="button" class="count-picker__btn"
                            disabled="@(count <= 1)"
                            @onclick="DecrementCount">−</button>
                    <input type="number"
                           @bind="count"
                           @bind:event="oninput"
                           @bind:after="OnCountChanged"
                           id="countInput"
                           class="count-picker__input"
                           min="1"
                           max="@MaxCount"
                           disabled="@selectAll" />
                    <button type="button" class="count-picker__btn"
                            disabled="@(count >= MaxCount)"
                            @onclick="IncrementCount">+</button>
                    <label class="count-picker__toggle @(selectAll ? "count-picker__toggle--active" : "")">
                        <input type="checkbox" @bind="selectAll" @bind:after="OnSelectAllChanged"
                               id="selectAllCheck" hidden />
                        @Translation.SelectAll
                    </label>
                </div>
            </div>

            @if (count > 1)
            {
                <div class="mb-4">
                    <div class="form-check" style="display: inline-flex; align-items: center; gap: 0.5rem;">
                        <input type="checkbox" @bind="oneAtATime" id="oneAtATimeCheck"
                               class="form-check-input" style="width: 1.2em; height: 1.2em;" />
                        <label for="oneAtATimeCheck" class="form-check-label" style="color: var(--text-secondary); font-weight: 500;">
                            @Translation.OneAtATime
                        </label>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    @errorMessage
                </div>
            }

            <button @onclick="ShowWheel"
                    class="btn-glow w-100"
                    disabled="@(!CanSpin)">
                @Translation.ShowWheelButton
            </button>

            @if (CanSpin && !showSaveInput)
            {
                <button @onclick="BeginSave" class="btn-ghost w-100 mt-2">
                    @Translation.SaveWheel
                </button>
            }

            @if (showSaveInput)
            {
                <div class="d-flex gap-2 mt-2 align-items-center">
                    <input @bind="saveWheelName" @bind:event="oninput"
                           class="form-control" style="max-width: 250px;"
                           placeholder="@Translation.SaveWheelPrompt"
                           @onkeydown="HandleSaveKeyDown" />
                    <button class="btn-ghost btn-sm" @onclick="ConfirmSaveWheel"
                            disabled="@(string.IsNullOrWhiteSpace(saveWheelName))">
                        ✓
                    </button>
                    <button class="btn-ghost btn-sm" @onclick="CancelSave">
                        ✕
                    </button>
                </div>
            }

            @if (wheelSaved)
            {
                <div class="toast-copied mt-2 text-center"><small>@Translation.WheelSaved</small></div>
            }
        </div>

        @if (savedWheels.Count > 0)
        {
            <div class="glass-card p-4 mt-4">
                <h2 style="font-weight: 600; font-size: 1.2rem; margin-bottom: 1rem;">@Translation.MyWheels</h2>
                @foreach (var wheel in savedWheels)
                {
                    <div class="saved-wheel-item">
                        <div>
                            <strong>@wheel.Name</strong>
                            <small>@string.Format(Translation.ItemCount, wheel.Items.Length)</small>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn-ghost btn-sm" @onclick="() => LoadWheel(wheel)">@Translation.LoadWheel</button>
                            <button class="btn-ghost btn-sm" style="color: var(--danger);" @onclick="() => DeleteWheel(wheel.Id)">@Translation.DeleteWheel</button>
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</div>

@code {
    private string itemsText = "";
    private int count = 1;
    private bool oneAtATime = true;
    private bool selectAll;
    private bool allowDuplicates;
    private string? errorMessage;
    private List<SavedWheel> savedWheels = [];
    private bool wheelSaved;
    private bool showSaveInput;
    private string saveWheelName = "";
    private System.Threading.Timer? toastTimer;

    protected override void OnInitialized()
    {
        CultureState.OnCultureChanged += OnCultureChanged;

        var uri = Navigation.Uri;
        var queryIndex = uri.IndexOf('?');
        if (queryIndex < 0) return;

        var queryString = uri[(queryIndex + 1)..];
        var pairs = queryString.Split('&', StringSplitOptions.RemoveEmptyEntries);

        foreach (var pair in pairs)
        {
            var parts = pair.Split('=', 2);
            if (parts.Length != 2) continue;

            var key = Uri.UnescapeDataString(parts[0]);
            var value = Uri.UnescapeDataString(parts[1]);

            if (key == "items") itemsText = value;
            else if (key == "count" && int.TryParse(value, out var c)) count = c;
            else if (key == "seq" && value == "true") oneAtATime = true;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        savedWheels = await SavedWheelService.GetAllAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var state = await JS.InvokeAsync<PartyStateDto>("PartyMode.loadState");
            var reducedMotion = await JS.InvokeAsync<bool>("PartyMode.prefersReducedMotion");
            PartyState.Load(state.Enabled, state.Intensity, reducedMotion, state.Muted);
            await JS.InvokeVoidAsync("PartyMode.setBodyClass", PartyState.Enabled, PartyState.EffectiveIntensity);
            StateHasChanged();
        }
    }

    private async Task ToggleParty()
    {
        PartyState.SetEnabled(!PartyState.Enabled);
        await JS.InvokeVoidAsync("PartyMode.saveState", PartyState.Enabled, PartyState.Intensity);
        await JS.InvokeVoidAsync("PartyMode.setBodyClass", PartyState.Enabled, PartyState.EffectiveIntensity);
        if (PartyState.Enabled)
            await JS.InvokeVoidAsync("PartyMode.initAudio");
    }

    private async Task ToggleMute()
    {
        PartyState.SetMuted(!PartyState.Muted);
        await JS.InvokeVoidAsync("PartyMode.setMuted", PartyState.Muted);
    }

    private async Task SetPartyLevel(int level)
    {
        // Toggle off if clicking the same level that's already active
        if (PartyState.Enabled && PartyState.Intensity == level)
        {
            await DisableParty();
            return;
        }
        PartyState.SetEnabled(true);
        PartyState.SetIntensity(level);
        await JS.InvokeVoidAsync("PartyMode.saveState", PartyState.Enabled, PartyState.Intensity);
        await JS.InvokeVoidAsync("PartyMode.setBodyClass", PartyState.Enabled, PartyState.EffectiveIntensity);
        await JS.InvokeVoidAsync("PartyMode.initAudio");
    }

    private async Task DisableParty()
    {
        PartyState.SetEnabled(false);
        await JS.InvokeVoidAsync("PartyMode.saveState", false, PartyState.Intensity);
        await JS.InvokeVoidAsync("PartyMode.setBodyClass", false, 0);
    }

    private record PartyStateDto(bool Enabled, int Intensity, bool Muted);

    private void OnCultureChanged() => InvokeAsync(StateHasChanged);

    private string[] ParsedItems => itemsText
        .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Where(s => !string.IsNullOrWhiteSpace(s))
        .ToArray();

    private IReadOnlyList<string> Duplicates => ParsedItems
        .GroupBy(s => s, StringComparer.OrdinalIgnoreCase)
        .Where(g => g.Count() > 1)
        .Select(g => g.Key)
        .ToList();

    private int MaxCount => Math.Max(1, ParsedItems.Length);

    private void OnSelectAllChanged()
    {
        if (selectAll)
            count = MaxCount;
    }

    private void OnCountChanged()
    {
        // Clamp to valid range
        if (count > MaxCount) count = MaxCount;
        if (count < 1) count = 1;
        // Sync selectAll state
        selectAll = count >= MaxCount && MaxCount > 1;
    }

    private void IncrementCount()
    {
        if (count < MaxCount) count++;
        selectAll = count >= MaxCount && MaxCount > 1;
    }

    private void DecrementCount()
    {
        if (count > 1) count--;
        selectAll = false;
    }

    private void OnItemsChanged()
    {
        if (selectAll)
            count = MaxCount;
        else if (count > MaxCount)
            count = MaxCount;

        // Reset override when duplicates are resolved
        if (Duplicates.Count == 0)
            allowDuplicates = false;
    }

    private bool CanSpin => ParsedItems.Length >= 2
                            && count >= 1
                            && count <= ParsedItems.Length
                            && (Duplicates.Count == 0 || allowDuplicates);

    private void ShowWheel()
    {
        errorMessage = null;
        var items = ParsedItems;

        if (items.Length < 2)
        {
            errorMessage = Translation.ErrorMinItems;
            return;
        }

        if (count < 1 || count > items.Length)
        {
            errorMessage = string.Format(Translation.ErrorPickCount, items.Length);
            return;
        }

        var duplicates = Duplicates;
        if (duplicates.Count > 0 && !allowDuplicates)
        {
            errorMessage = string.Format(Translation.ErrorDuplicates, string.Join(", ", duplicates));
            return;
        }

        var escapedItems = Uri.EscapeDataString(string.Join("\n", items));
        var seqParam = count > 1 && oneAtATime ? "&seq=true" : "";
        Navigation.NavigateTo($"/wheel?items={escapedItems}&count={count}{seqParam}");
    }

    private void BeginSave()
    {
        showSaveInput = true;
        saveWheelName = "";
    }

    private void CancelSave()
    {
        showSaveInput = false;
        saveWheelName = "";
    }

    private async Task HandleSaveKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await ConfirmSaveWheel();
        else if (e.Key == "Escape")
            CancelSave();
    }

    private async Task ConfirmSaveWheel()
    {
        if (string.IsNullOrWhiteSpace(saveWheelName)) return;

        var wheel = new SavedWheel
        {
            Name = saveWheelName.Trim(),
            Items = ParsedItems,
            PickCount = count
        };

        await SavedWheelService.SaveAsync(wheel);
        savedWheels = await SavedWheelService.GetAllAsync();

        showSaveInput = false;
        saveWheelName = "";
        wheelSaved = true;
        StateHasChanged();

        toastTimer?.Dispose();
        toastTimer = new System.Threading.Timer(_ =>
        {
            wheelSaved = false;
            InvokeAsync(StateHasChanged);
        }, null, 2000, Timeout.Infinite);
    }

    private void LoadWheel(SavedWheel wheel)
    {
        itemsText = string.Join("\n", wheel.Items);
        count = wheel.PickCount;
    }

    private async Task DeleteWheel(string id)
    {
        await SavedWheelService.DeleteAsync(id);
        savedWheels = await SavedWheelService.GetAllAsync();
    }

    public void Dispose()
    {
        CultureState.OnCultureChanged -= OnCultureChanged;
        toastTimer?.Dispose();
    }
}
