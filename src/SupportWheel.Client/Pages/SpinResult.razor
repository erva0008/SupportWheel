@page "/spin/{EncodedData}"
@implements IDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject CultureState CultureState
@inject SavedWheelService SavedWheelService

<PageTitle>@Translation.PageTitleResult</PageTitle>

@if (spinData is null)
{
    <div class="text-center py-5">
        <div class="glass-card d-inline-block p-4 p-md-5">
            <h4 style="font-weight: 600;">@Translation.InvalidLink</h4>
            <p style="color: var(--text-secondary);">@Translation.LinkCorrupt</p>
            <a href="/" class="btn-glow" style="text-decoration: none;">@Translation.CreateNewSpin</a>
        </div>
    </div>
}
else
{
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8 text-center">

            @if (isSequential && !allRoundsComplete)
            {
                <div class="glass-card p-3 mb-3" style="font-size: 0.95rem;">
                    <span style="color: var(--text-secondary);">@Translation.RoundLabel</span>
                    <strong style="color: var(--accent-light);">@(currentRound + 1)</strong>
                    <span style="color: var(--text-secondary);">@Translation.OfLabel @totalRounds</span>

                    @if (revealedWinners.Count > 0)
                    {
                        <div class="mt-2" style="font-size: 0.85rem; color: var(--text-secondary);">
                            @string.Format(Translation.AlreadyPicked, string.Join(", ", revealedWinners))
                        </div>
                    }
                </div>
            }

            @* Wheel canvas — pointers are drawn on the canvas itself *@
            <div class="wheel-wrapper mb-4">
                <canvas id="wheelCanvas" width="500" height="500"
                        style="max-width: 100%; height: auto;"></canvas>
            </div>

            @* Sequential mode: round complete but not all rounds done *@
            @if (isSequential && !roundInProgress && !allRoundsComplete && revealedWinners.Count > 0)
            {
                <div class="glass-card p-4 mt-3">
                    <h3 style="font-weight: 700; font-size: 1.3rem; margin-bottom: 0.5rem;
                               color: var(--success);">
                        @string.Format(Translation.RoundWinner, revealedWinners[^1])
                    </h3>
                    <button @onclick="NextRound" class="btn-glow mt-2">
                        @Translation.NextRound
                    </button>
                </div>
            }

            @* Result section — shown after all animations complete *@
            @if (animationComplete)
            {
                <div class="glass-card p-4 mt-3">
                    <h3 style="font-weight: 700; font-size: 1.5rem; margin-bottom: 1rem;
                               background: linear-gradient(135deg, #34d399, #60a5fa);
                               -webkit-background-clip: text; -webkit-text-fill-color: transparent;
                               background-clip: text;">
                        @Translation.Selected
                    </h3>
                    <ul class="result-list">
                        @if (isSequential)
                        {
                            @foreach (var name in revealedWinners)
                            {
                                <li>✅ @name</li>
                            }
                        }
                        else
                        {
                            @foreach (var name in spinData.Selected)
                            {
                                <li>✅ @name</li>
                            }
                        }
                    </ul>
                </div>

                <div class="mt-4 d-flex gap-2 justify-content-center flex-wrap">
                    <button @onclick="CopyLink" class="btn-ghost">
                        @Translation.CopyLinkButton
                    </button>
                    <button @onclick="SpinAgain" class="btn-ghost">
                        @Translation.SpinAgainButton
                    </button>
                    @if (!showSaveInput)
                    {
                        <button @onclick="BeginSave" class="btn-ghost">
                            @Translation.SaveWheel
                        </button>
                    }
                    <button @onclick="EditItems" class="btn-ghost">
                        @Translation.EditItemsButton
                    </button>
                    <a href="/" class="btn-glow" style="text-decoration: none; font-size: 1rem; padding: 0.6rem 1.2rem;">
                        @Translation.NewSpinButton
                    </a>
                </div>

                @if (showSaveInput)
                {
                    <div class="d-flex gap-2 mt-3 align-items-center justify-content-center">
                        <input @bind="saveWheelName" @bind:event="oninput"
                               class="form-control" style="max-width: 250px;"
                               placeholder="@Translation.SaveWheelPrompt"
                               @onkeydown="HandleSaveKeyDown" />
                        <button class="btn-ghost btn-sm" @onclick="ConfirmSaveWheel"
                                disabled="@(string.IsNullOrWhiteSpace(saveWheelName))">
                            ✓
                        </button>
                        <button class="btn-ghost btn-sm" @onclick="CancelSave">
                            ✕
                        </button>
                    </div>
                }

                @if (linkCopied)
                {
                    <div class="toast-copied mt-2"><small>@Translation.LinkCopied</small></div>
                }
                @if (wheelSaved)
                {
                    <div class="toast-copied mt-2"><small>@Translation.WheelSaved</small></div>
                }
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public string? EncodedData { get; set; }

    private SpinData? spinData;
    private bool animationComplete;
    private bool needsAnimation;
    private bool linkCopied;
    private bool wheelSaved;
    private bool showSaveInput;
    private string saveWheelName = "";
    private DotNetObjectReference<SpinResult>? dotNetRef;
    private System.Threading.Timer? toastTimer;

    // Sequential mode state
    private bool isSequential;
    private int currentRound;
    private int totalRounds;
    private bool roundInProgress;
    private bool allRoundsComplete;
    private List<string> revealedWinners = [];

    protected override void OnInitialized()
    {
        CultureState.OnCultureChanged += OnCultureChanged;
    }

    private void OnCultureChanged() => InvokeAsync(StateHasChanged);

    protected override void OnParametersSet()
    {
        animationComplete = false;
        linkCopied = false;
        wheelSaved = false;
        showSaveInput = false;
        saveWheelName = "";
        needsAnimation = false;
        isSequential = false;
        currentRound = 0;
        totalRounds = 0;
        roundInProgress = false;
        allRoundsComplete = false;
        revealedWinners.Clear();

        if (string.IsNullOrEmpty(EncodedData))
        {
            spinData = null;
            return;
        }

        try
        {
            spinData = SpinEncoder.Decode(EncodedData);
        }
        catch (FormatException)
        {
            spinData = null;
            return;
        }

        var uri = new Uri(Navigation.Uri);
        isSequential = uri.Query.Contains("seq=true", StringComparison.OrdinalIgnoreCase);
        totalRounds = spinData.Count;
        needsAnimation = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!needsAnimation || spinData is null)
            return;

        needsAnimation = false;

        dotNetRef?.Dispose();
        dotNetRef = DotNetObjectReference.Create(this);

        if (isSequential)
        {
            roundInProgress = true;
            var (roundItems, winnerIdx) = GetRoundData(currentRound);
            await JS.InvokeVoidAsync("WheelCanvas.startSpin",
                "wheelCanvas", roundItems, winnerIdx, dotNetRef);
        }
        else
        {
            await JS.InvokeVoidAsync("WheelCanvas.startSpin",
                "wheelCanvas", spinData.Items, spinData.SelectedIndices, dotNetRef);
        }
    }

    private (string[] items, int[] winnerIndex) GetRoundData(int roundIndex)
    {
        var revealOrder = spinData!.RevealOrderIndices ?? spinData.SelectedIndices;

        // Indices of winners already revealed in previous rounds
        var revealedSet = new HashSet<int>();
        for (int i = 0; i < roundIndex; i++)
            revealedSet.Add(revealOrder[i]);

        var roundItems = new List<string>();
        int winnerOriginalIndex = revealOrder[roundIndex];
        int winnerRoundIndex = -1;

        for (int i = 0; i < spinData.Items.Length; i++)
        {
            if (revealedSet.Contains(i)) continue;
            if (i == winnerOriginalIndex)
                winnerRoundIndex = roundItems.Count;
            roundItems.Add(spinData.Items[i]);
        }

        return (roundItems.ToArray(), [winnerRoundIndex]);
    }

    /// <summary>
    /// Called from JavaScript when the animation completes.
    /// </summary>
    [JSInvokable]
    public void OnSpinComplete()
    {
        if (isSequential)
        {
            roundInProgress = false;
            var revealOrder = spinData!.RevealOrderIndices ?? spinData.SelectedIndices;
            revealedWinners.Add(spinData.Items[revealOrder[currentRound]]);

            if (currentRound + 1 >= totalRounds)
            {
                allRoundsComplete = true;
                animationComplete = true;
            }

            StateHasChanged();
        }
        else
        {
            animationComplete = true;
            StateHasChanged();
        }
    }

    private void NextRound()
    {
        currentRound++;
        needsAnimation = true;
        StateHasChanged();
    }

    private async Task CopyLink()
    {
        var uri = Navigation.Uri;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", uri);
        linkCopied = true;
    }

    private void SpinAgain()
    {
        if (spinData is null) return;

        var newResult = WheelSpinner.Spin(spinData.Items, spinData.Count);
        var encoded = SpinEncoder.Encode(newResult);
        var seqParam = isSequential ? "?seq=true" : "";
        Navigation.NavigateTo($"/spin/{encoded}{seqParam}", forceLoad: false);
    }

    private void EditItems()
    {
        if (spinData is null) return;

        var itemsParam = Uri.EscapeDataString(string.Join("\n", spinData.Items));
        var seqParam = isSequential ? "&seq=true" : "";
        Navigation.NavigateTo($"/?items={itemsParam}&count={spinData.Count}{seqParam}");
    }

    private void BeginSave()
    {
        showSaveInput = true;
        saveWheelName = "";
    }

    private void CancelSave()
    {
        showSaveInput = false;
        saveWheelName = "";
    }

    private async Task HandleSaveKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await ConfirmSaveWheel();
        else if (e.Key == "Escape")
            CancelSave();
    }

    private async Task ConfirmSaveWheel()
    {
        if (spinData is null || string.IsNullOrWhiteSpace(saveWheelName)) return;

        var wheel = new SavedWheel
        {
            Name = saveWheelName.Trim(),
            Items = spinData.Items,
            PickCount = spinData.Count
        };

        await SavedWheelService.SaveAsync(wheel);

        showSaveInput = false;
        saveWheelName = "";
        wheelSaved = true;
        StateHasChanged();

        toastTimer?.Dispose();
        toastTimer = new System.Threading.Timer(_ =>
        {
            wheelSaved = false;
            InvokeAsync(StateHasChanged);
        }, null, 2000, Timeout.Infinite);
    }

    public void Dispose()
    {
        CultureState.OnCultureChanged -= OnCultureChanged;
        dotNetRef?.Dispose();
        toastTimer?.Dispose();
    }
}
